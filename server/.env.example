# Copy to .env for running PHP outside the compose stack (rare). Inside compose, the
# environment comes from compose.yaml plus compose.override.yaml; see docs/runbooks/local-development.md.
# Variable names match what server/config/*.php actually reads.

APP_NAME=LRC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lrc
DB_USERNAME=lrc
DB_PASSWORD=lrc
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# config/cache.php reads CACHE_STORE (not CACHE_DRIVER).
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
BROADCAST_DRIVER=log
# config/filesystems.php reads FILESYSTEM_DRIVER.
FILESYSTEM_DRIVER=local

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Error reporting (leave empty locally).
SENTRY_LARAVEL_DSN=
SENTRY_JS_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# S3 uploads (league/flysystem-aws-s3-v3); leave empty unless FILESYSTEM_DRIVER=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
